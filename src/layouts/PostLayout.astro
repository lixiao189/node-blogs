---
import type { MarkdownHeading } from "astro";
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import PostNav from "@/components/post/PostNav.astro";
import TagList from "@/components/post/TagList.astro";
import Toc from "@/components/post/Toc.astro";
import { formatDate } from "@/lib/date";
import { type Post, getReadingMinutes, postUrl } from "@/lib/posts";
import { site } from "@/site.config";
import BaseLayout from "./BaseLayout.astro";
import "katex/dist/katex.min.css";

interface Props {
	post: Post;
	headings: MarkdownHeading[];
	newer?: Post | undefined;
	older?: Post | undefined;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, publishDate, updatedDate, tags, cover, coverAlt, ogImage } = post.data;

// A single heading is not worth a TOC (same rule as Toc.astro)
const hasToc = headings.filter((h) => h.depth >= 2 && h.depth <= 3).length > 1;

const socialImage = ogImage ?? `/og-image/${post.id}.png`;
const url = new URL(postUrl(post), Astro.site).href;
const editUrl = `https://github.com/lixiao189/node-blogs/edit/main/${post.filePath}`;

const schema = [
	{
		"@context": "https://schema.org",
		"@type": "BlogPosting",
		headline: title,
		description,
		url,
		mainEntityOfPage: url,
		image: new URL(socialImage, Astro.site).href,
		datePublished: publishDate.toISOString(),
		dateModified: (updatedDate ?? publishDate).toISOString(),
		keywords: tags.join(", "),
		inLanguage: site.lang,
		author: { "@type": "Person", name: site.author, url: Astro.site?.href },
	},
	{
		"@context": "https://schema.org",
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "首页", item: Astro.site?.href },
			{ "@type": "ListItem", position: 2, name: "文章", item: new URL("/posts", Astro.site).href },
			{ "@type": "ListItem", position: 3, name: title, item: url },
		],
	},
];
---

<BaseLayout
	title={title}
	description={description}
	image={socialImage}
	article={{ publishedTime: publishDate, modifiedTime: updatedDate, tags }}
	schema={schema}
>
	<article class="w-full min-w-0">
		<header class="mb-8">
			<h1 class="text-[1.75rem] leading-snug font-bold tracking-tight text-heading sm:text-3xl">
				{title}
			</h1>
			<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
				<span class="inline-flex items-center gap-1.5">
					<Icon name="calendar" class="size-4" />
					<time datetime={publishDate.toISOString()}>{formatDate(publishDate)}</time>
				</span>
				{updatedDate && (
					<span class="inline-flex items-center gap-1.5">
						<Icon name="edit" class="size-4" />
						更新于 <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
					</span>
				)}
				<span class="inline-flex items-center gap-1.5">
					<Icon name="clock" class="size-4" />约 {getReadingMinutes(post)} 分钟
				</span>
			</div>
			{tags.length > 0 && (
				<div class="mt-4">
					<TagList tags={tags} />
				</div>
			)}
			{cover && (
				<Image
					src={cover}
					alt={coverAlt ?? title}
					class="mt-8 w-full rounded-xl"
					loading="eager"
					fetchpriority="high"
				/>
			)}
		</header>

		<div class="prose">
			<slot />
		</div>

		<footer class="mt-12 flex items-center justify-between border-t border-border pt-6 text-sm">
			<a href={editUrl} class="inline-flex items-center gap-1.5 text-muted hover:text-heading">
				<Icon name="edit" class="size-4" /> 在 GitHub 上编辑
			</a>
			<a href="#main" class="inline-flex items-center gap-1.5 text-muted hover:text-heading">
				<Icon name="arrow-up" class="size-4" /> 回到顶部
			</a>
		</footer>

		<PostNav newer={newer} older={older} />
	</article>

	<!-- TOC stays out of the way until asked for: a floating button opens it as a popover -->
	{hasToc && (
		<>
			<button
				type="button"
				popovertarget="toc-panel"
				aria-label="文章目录"
				title="文章目录"
				class="fixed right-5 bottom-5 z-30 grid size-11 place-items-center rounded-full border border-border bg-bg/80 text-muted shadow-lg backdrop-blur-md transition-colors hover:text-heading sm:right-8 sm:bottom-8"
			>
				<Icon name="list" class="size-5" />
			</button>
			<div
				id="toc-panel"
				popover
				class="toc-panel inset-auto right-5 bottom-19 m-0 max-h-[min(32rem,70dvh)] w-[min(20rem,calc(100vw-2.5rem))] overflow-y-auto rounded-xl border border-border bg-bg p-4 text-fg shadow-xl sm:right-8 sm:bottom-22"
			>
				<Toc headings={headings} />
			</div>
		</>
	)}
</BaseLayout>

<script>
	import mediumZoom from "medium-zoom";

	// Linked images keep their link; everything else in the article can be zoomed
	const images = [...document.querySelectorAll<HTMLImageElement>(".prose img:not(a img)")];

	for (const img of document.querySelectorAll<HTMLImageElement>(".prose img")) {
		if (img.complete && img.naturalWidth) continue;
		img.dataset.loading = "";
		const done = () => {
			img.removeAttribute("data-loading");
			img.toggleAttribute("data-loaded", img.naturalWidth > 0);
		};
		img.addEventListener("load", done, { once: true });
		img.addEventListener("error", done, { once: true });
	}

	mediumZoom(images, { margin: 24, background: "var(--theme-bg)" });

	// Jumping to a section should also put the TOC away
	const tocPanel = document.getElementById("toc-panel");
	tocPanel?.addEventListener("click", (e) => {
		if ((e.target as Element).closest("a")) tocPanel.hidePopover();
	});
</script>
