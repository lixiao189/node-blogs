---
import Icon from "@/components/Icon.astro";
import { site, socials } from "@/site.config";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-border">
	<div class="container-page flex flex-col items-center gap-4 py-8 text-sm text-muted sm:flex-row sm:justify-between">
		<p>
			© 2023–{year} {site.author} · Built with Astro
		</p>
		<ul class="flex items-center gap-1">
			{socials.map((s) => (
				<li>
					<a
						href={s.href}
						class="inline-flex size-9 items-center justify-center rounded-full transition-colors hover:bg-surface hover:text-heading"
						{...(s.href.startsWith("http") && { target: "_blank", rel: "me noopener noreferrer" })}
					>
						<Icon name={s.icon} />
						<span class="sr-only">{s.name}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</footer>
