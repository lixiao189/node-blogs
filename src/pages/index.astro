---
import PostItem from "@/components/post/PostItem.astro";
import TagList from "@/components/post/TagList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getTagsWithCount } from "@/lib/posts";
import { site } from "@/site.config";

const posts = await getPosts();
const recent = posts.slice(0, site.postsPerHomePage);
const topTags = getTagsWithCount(posts).slice(0, 12);
---

<BaseLayout>
	<h1 class="sr-only">{site.title}</h1>
	<section aria-labelledby="recent-heading">
		<div class="mb-2 flex items-baseline justify-between">
			<h2 id="recent-heading" class="text-sm font-semibold tracking-widest text-muted uppercase">
				最近更新
			</h2>
			<a href="/posts" class="text-sm text-muted hover:text-heading">
				共 {posts.length} 篇 →
			</a>
		</div>
		<ul class="divide-y divide-border/60">
			{recent.map((post) => (
				<PostItem post={post} />
			))}
		</ul>
	</section>

	<section aria-labelledby="tags-heading" class="mt-14">
		<h2 id="tags-heading" class="mb-4 text-sm font-semibold tracking-widest text-muted uppercase">
			常用标签
		</h2>
		<TagList tags={topTags} />
	</section>
</BaseLayout>
