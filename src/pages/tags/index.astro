---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPosts, getTagsWithCount, tagUrl } from "@/lib/posts";

const tags = getTagsWithCount(await getPosts());
---

<BaseLayout title="标签" description={`博客中的全部 ${tags.length} 个标签。`}>
	<h1 class="text-3xl font-bold tracking-tight text-heading">标签</h1>
	<p class="mt-2 text-muted">共 {tags.length} 个标签。</p>

	<ul class="mt-10 grid grid-cols-2 gap-2 sm:grid-cols-3">
		{tags.map(([tag, count]) => (
			<li>
				<a
					href={tagUrl(tag)}
					class="flex items-center justify-between rounded-lg border border-border px-3 py-2 transition-colors hover:border-accent hover:text-accent"
				>
					<span>#{tag}</span>
					<span class="text-xs text-muted tabular-nums">{count}</span>
				</a>
			</li>
		))}
	</ul>
</BaseLayout>
