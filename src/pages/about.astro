---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { friends } from "@/site.config";
---

<BaseLayout title="关于" description="Loving RE, loving pwn, loving anime.">
	<h1 class="text-3xl font-bold tracking-tight text-heading">关于</h1>
	<div class="prose mt-6">
		<p>
			全民制作人大家好，我是练习 n 年半的二进制安全练习生，喜欢 PWN, RE, 本来以前很喜欢 cxk
			的，现在更喜欢了
		</p>
	</div>

	<h2 class="mt-14 mb-4 text-xl font-semibold text-heading">友链</h2>
	<ul class="grid gap-3 sm:grid-cols-2">
		{friends.map((f) => (
			<li>
				<a
					href={f.href}
					target="_blank"
					rel="noopener"
					class="block h-full rounded-xl border border-border p-4 transition-colors hover:border-accent"
				>
					<span class="block font-medium text-heading">{f.name}</span>
					<span class="mt-1 block text-sm text-muted">{f.desc}</span>
				</a>
			</li>
		))}
	</ul>
</BaseLayout>
