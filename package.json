{
	"name": "node-blogs",
	"version": "3.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.23.4"
	},
	"scripts": {
		"dev": "astro dev --force",
		"start": "astro dev --force",
		"sync": "astro sync",
		"check": "astro check",
		"clean": "node -e \"for (const d of ['.astro', 'node_modules/.astro']) require('fs').rmSync(d, { recursive: true, force: true })\"",
		"build": "astro build --force",
		"preview": "astro preview",
		"new": "node scripts/new-post.mjs",
		"format": "prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"lint": "biome lint ."
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.4",
		"@astrojs/mdx": "^8.1.1",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@vercel/speed-insights": "^2.0.0",
		"astro": "^7.4.2",
		"astro-expressive-code": "^0.44.3",
		"katex": "^0.19.1",
		"medium-zoom": "1.1.0",
		"reading-time": "^1.5.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-katex": "^7.0.1",
		"remark-github-blockquote-alert": "^2.1.0",
		"remark-math": "^6.0.0",
		"sanitize-html": "^2.18.1",
		"satori": "^0.63.2",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@biomejs/biome": "^2.6.3",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/sanitize-html": "^2.16.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"overrides": {
			"ajv@>=7 <8.18.0": "^8.18.0",
			"fast-uri@>=3 <3.1.9": "^3.1.9",
			"fflate@>=0.7 <0.7.5": "^0.7.5",
			"katex@<0.18.2": "^0.19.1",
			"mdast-util-to-hast@>=13 <13.2.1": "^13.2.1",
			"nanoid@<3.3.18": "^3.3.18",
			"picomatch@<2.3.2": "^2.3.2",
			"postcss@<8.5.23": "^8.5.23",
			"postcss-selector-parser@<6.1.5": "^6.1.5",
			"postcss-selector-parser@>=7 <7.1.6": "^7.1.6",
			"source-map-js@>=1 <1.2.2": "^1.2.2"
		}
	}
}
